# ==============================================================================
# SECURE PERSONAL FINANCE MANAGEMENT SYSTEM - CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=production

# Server Port (Local Node.js process default: 3002)
PORT=3002

# PostgreSQL Database Connection String (MANDATORY for Production / Vercel Serverless / Neon)
# Vercel Functions are ephemeral; SQLite under /tmp is non-durable across cold starts.
# Managed PostgreSQL (e.g. Neon, Supabase, RDS) with SSL is required for production persistence.
# e.g. postgresql://user:password@ep-sample-pooler.neon.tech/aegis_finance?sslmode=require
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

# Session Token HMAC Signing Secret (MANDATORY in Production)
# Must be a cryptographically secure random secret of at least 32 characters (e.g. openssl rand -hex 32).
# Never expose via VITE_* variables or commit directly to git repositories.
SESSION_SECRET=your_minimum_32_character_cryptographically_secure_session_secret_here
# AUTH_SECRET is supported as a fallback alias for SESSION_SECRET
# AUTH_SECRET=your_minimum_32_character_cryptographically_secure_session_secret_here

# Enable/Disable Interactive Demo Mode Dataset & Sandboxes
DEMO_MODE=false

# AI / NLP Cognitive Insights Engine (Google Gemini API Key)
# Note: In production, configure this in your Vercel Project Environment Variables.
# The server will automatically use local offline heuristics if unconfigured.
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database Storage Directory (Defaults to /tmp/data on Vercel, ./data locally)
# Used when DATABASE_URL is not set (development fallback)
# SQLITE_STORAGE_DIR=/tmp/data

# Session Inactivity Timeout in Minutes (Default: 30)
DEFAULT_SESSION_TIMEOUT_MINUTES=30

# CORS Allowed Origins (Comma-separated list, e.g. https://your-project.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173,https://*.vercel.app
